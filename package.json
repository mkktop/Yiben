{
  "name": "yiben",
  "productName": "一本 Yiben",
  "version": "0.2.2",
  "description": "精美的本地 + 天翼云盘漫画阅读器",
  "main": "./out/main/index.js",
  "author": "yiben",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.yiben.app",
    "productName": "一本 Yiben",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/7zip-bin/**",
      "**/node_modules/sharp/**",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/node-unrar-js/**"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://yiben.kaikun.top"
    },
    "releaseNotesFile": "RELEASE_NOTES.md",
    "files": [
      "out/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README_*.md,.md}",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "cbz",
          "name": "漫画压缩包 (CBZ)",
          "description": "用一本 Yiben 打开漫画压缩包",
          "icon": "build/icon.ico"
        },
        {
          "ext": "cbr",
          "name": "漫画压缩包 (CBR)",
          "description": "用一本 Yiben 打开漫画压缩包",
          "icon": "build/icon.ico"
        },
        {
          "ext": "cb7",
          "name": "漫画压缩包 (CB7)",
          "description": "用一本 Yiben 打开漫画压缩包",
          "icon": "build/icon.ico"
        },
        {
          "ext": "cbt",
          "name": "漫画压缩包 (CBT)",
          "description": "用一本 Yiben 打开漫画压缩包",
          "icon": "build/icon.ico"
        },
        {
          "ext": "pdf",
          "name": "PDF 文档",
          "description": "用一本 Yiben 打开 PDF 漫画",
          "icon": "build/icon.ico"
        }
      ]
    },
    "mac": {
      "fileAssociations": [
        {
          "ext": "cbz",
          "name": "漫画压缩包 (CBZ)",
          "description": "用一本 Yiben 打开漫画压缩包",
          "role": "Viewer"
        },
        {
          "ext": "cbr",
          "name": "漫画压缩包 (CBR)",
          "description": "用一本 Yiben 打开漫画压缩包",
          "role": "Viewer"
        },
        {
          "ext": "cb7",
          "name": "漫画压缩包 (CB7)",
          "description": "用一本 Yiben 打开漫画压缩包",
          "role": "Viewer"
        },
        {
          "ext": "cbt",
          "name": "漫画压缩包 (CBT)",
          "description": "用一本 Yiben 打开漫画压缩包",
          "role": "Viewer"
        },
        {
          "ext": "pdf",
          "name": "PDF 文档",
          "description": "用一本 Yiben 打开 PDF 漫画",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Yiben_${version}_setup.exe",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@tanstack/react-virtual": "^3.14.11",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "cloud189-sdk": "^1.0.9",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^0.544.0",
    "node-stream-zip": "^1.16.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
